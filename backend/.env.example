# Backend Environment Variables

# Server
NODE_ENV=development
PORT=3000

# MariaDB Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DB_V4_ENVIROMENT_MONITOR_WEB
DB_USER=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_DAYS=7

# Email (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@enviromonitor.com
FRONTEND_URL=http://localhost:5173

# Review reminder emails
REVIEW_REMINDER_ENABLED=false
REVIEW_REMINDER_CRON=0 9 * * *
REVIEW_REMINDER_LIMIT=50

# Translation provider
# Use Azure for production translation. If AZURE_TRANSLATOR_KEY is set, backend auto-selects Azure.
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=your_azure_region_here
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Translation API throttling/cache
TRANSLATION_CONCURRENCY=1
TRANSLATION_REQUEST_DELAY_MS=2200
TRANSLATION_TIMEOUT_MS=45000
TRANSLATION_RETRY_ATTEMPTS=4
TRANSLATION_RETRY_BASE_DELAY_MS=2500
TRANSLATION_RATE_LIMIT_COOLDOWN_MS=120000
TRANSLATION_BATCH_MAX_LENGTH=4500
TRANSLATION_CACHE_TTL_MS=604800000
TRANSLATION_CACHE_MAX_ITEMS=1000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
